# -------------------------------------
# User / Group Identifiers (PUID / PGID)
# -------------------------------------
# Set these to match the user that owns your config and media files.
# Default for TrueNAS Scale apps is often 568.
PUID=568
PGID=568

# Timezone (e.g. Europe/Paris, America/New_York)
TZ=Europe/Paris

# Application Port (Host port mapping)
APP_PORT=9876

# -------------------------------------
# File Paths (Host mappings)
# -------------------------------------
# Where to store the app's configuration (database, etc.)
CONFIG_PATH=./config

# Path on your host to your main downloads/media folder.
# This single path will be mounted as /data inside the container.
# All Sonarr/Radarr library paths inside the container should be relative to this.
DOWNLOADS_HOST_PATH=/mnt/TANK/Downloads

# -------------------------------------
# Sonarr Configuration
# -------------------------------------
SONARR_URL=http://your-sonarr-ip:8989
SONARR_API_KEY=your_sonarr_api_key_here

# -------------------------------------
# Radarr Configuration
# -------------------------------------
RADARR_URL=http://your-radarr-ip:7878
RADARR_API_KEY=your_radarr_api_key_here

# -------------------------------------
# qBittorrent Configuration
# -------------------------------------
QBITTORRENT_URL=http://your-qbittorrent-ip:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# Optional: Path mapping if qBittorrent sees a different path than CleanrrNAS
# Example: If qBit downloads to /downloads but CleanrrNAS mounts it to /data
# QBITTORRENT_PATH_MAPPING=/downloads:/data
QBITTORRENT_PATH_MAPPING=

# -------------------------------------
# MediaCleaner Settings
# -------------------------------------
# How many days must a torrent seed before it's considered for cleanup?
HIT_AND_RUN_DAYS=7
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
